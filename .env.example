# Optional. Without these, cards travel inside the link and the wall is a local
# showcase — which is what the static demo runs on.
#
# With them, links become short ?c=<id> and the wall is shared. Posting to a
# shared wall requires Google sign-in and a review queue; see MODERATION.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=cards
